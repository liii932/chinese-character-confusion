# Share only the current character-recognition project materials.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/lean-decisive-research/
!/形近字识别项目设计书.md
!/笔画微差类（长短、出头、点撇微殊）.md
!/ppt设计.md
!/PPT提纲_81字阶段汇报_2026-10-13.md
!/技术报告提纲_81字形近字识别_2026-10-13.md
!/pilot/
!/training/
!/colab/

# Local Python environments and caches are not shared.
.venv/
__pycache__/
*.py[cod]

# Generated datasets, checkpoints, upload bundles and local verification outputs.
/training/data/
/training/runs/
/training/.verification/
/colab/dist/
/colab/*.pt

# Independent pilot outputs; never commit generated training data or checkpoints.
/pilot/dataset_81*/
/pilot/checkpoints_a*/
/pilot/.verification/
